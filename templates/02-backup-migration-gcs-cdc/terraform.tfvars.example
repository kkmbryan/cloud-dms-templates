# ==============================================================================
# Scenario 2: Seed from a backup in GCS (mysqldump / XtraBackup) + CDC
# ==============================================================================
# Copy to terraform.tfvars (git-ignored). Prefer TF_VAR_cloudsql_root_password
# and TF_VAR_source_gce_mysql_password environment variables over writing
# passwords to disk, for example from Secret Manager:
#   export TF_VAR_source_gce_mysql_password="$(gcloud secrets versions access latest --secret=dms-source-password)"
# Keep state in a protected remote backend: see backend.tf.example.

project_id            = "my-gcp-project-01"
region                = "europe-west2"
connectivity_type     = "PSC"
network               = "projects/my-gcp-project-01/global/networks/my-vpc"
subnet                = "projects/my-gcp-project-01/regions/europe-west2/subnetworks/db-subnet"
# Recommended: a dedicated small subnet (for example a /28) for the Network Attachment
network_attachment_subnet = "projects/my-gcp-project-01/regions/europe-west2/subnetworks/dms-na-subnet"
# network_attachment_name = "dms-mysql-psc-na" # use a unique name per stack in the same project and region

# Network Attachment authorization: ACCEPT_MANUAL (default) accepts only the
# Cloud SQL tenant project, derived from the instance in the same apply.
psc_connection_preference = "ACCEPT_MANUAL"
# psc_producer_accept_list = []            # override only if you must
# allowed_psc_consumer_projects = []       # extra application projects for PSC endpoints

# Firewall: allow tcp:3306 from the Network Attachment subnet to the source VM
create_source_firewall_rule = true
source_target_tags          = ["mysql-source"]
# source_target_service_accounts = ["mysql-source-vm@my-gcp-project-01.iam.gserviceaccount.com"] # instead of tags

# PSC consumer endpoint + private DNS for applications (created by default)
create_psc_endpoint = true
psc_endpoint_subnet = "projects/my-gcp-project-01/regions/europe-west2/subnetworks/app-subnet"

# GCS staging bucket and seed location
# Read access for the DMS service agent and the Cloud SQL instance service
# account is granted automatically.
staging_bucket_name           = "my-dms-staging-bucket"
staging_bucket_retention_days = 14
staging_bucket_noncurrent_version_retention_days = 7
# staging_bucket_kms_key_name = "projects/my-gcp-project-01/locations/europe-west2/keyRings/dms/cryptoKeys/staging" # CMEK
backup_writer_members         = ["serviceAccount:mysql-source-vm@my-gcp-project-01.iam.gserviceaccount.com"]

# Seed format (see the support matrix in README.md):
#   LOGICAL  (default): one mysqldump file; MYSQL_8_0 or MYSQL_8_4 target.
#   PHYSICAL          : dedicated folder with a prepared XtraBackup; MYSQL_8_0 target only.
dump_type       = "LOGICAL"
backup_gcs_path = "mysqldump/mysql80-dump.sql.gz"
# dump_type               = "PHYSICAL"
# backup_gcs_path         = "xtrabackup/mysql80-full"
# target_database_version = "MYSQL_8_0"

# Destination Cloud SQL configuration (MYSQL_8_4 default or MYSQL_8_0)
cloudsql_instance_name       = "cloudsql-mysql-dest-bkp-01"
target_database_version      = "MYSQL_8_4"
cloudsql_edition             = "ENTERPRISE_PLUS"
cloudsql_tier                = "db-perf-optimized-N-8"
cloudsql_availability_type   = "REGIONAL"
cloudsql_disk_size_gb        = 1000
cloudsql_root_password       = "REPLACE_WITH_SECURE_ROOT_PASSWORD"
cloudsql_deletion_protection = true
cloudsql_ssl_mode            = "ENCRYPTED_ONLY"
# cloudsql_kms_key_name = "projects/my-gcp-project-01/locations/europe-west2/keyRings/dms/cryptoKeys/cloudsql" # CMEK, set at creation only
# cloudsql_password_validation_policy = { min_length = 14 } # enable after promotion, not at creation
# cloudsql_lower_case_table_names = 1 # IMMUTABLE: set only if the source uses 1 (SELECT @@lower_case_table_names)

# Source MySQL 8.0 VM (binlog CDC after the seed is restored)
source_gce_mysql_host     = "10.10.0.10"
source_gce_mysql_port     = 3306
source_gce_mysql_username = "dms_migration"
source_gce_mysql_password = "REPLACE_ME_MAX_32_CHARS"

# TLS from DMS to the source (REQUIRED default; SERVER_ONLY / SERVER_CLIENT verify certificates)
source_ssl_type = "REQUIRED"
# source_ssl_ca_certificate = "-----BEGIN CERTIFICATE-----..." # or TF_VAR_source_ssl_ca_certificate="$(cat ca.pem)"

# DMS backup-seeded migration + CDC job
migration_job_id = "gcs-bkp-mysql80-cdc"

# Two-phase apply (DMS checks that the seed exists when the job is created):
#   1) terraform apply -var create_migration_job=false
#   2) upload the seed to the configured_dump_path output
#   3) terraform apply            # create_migration_job = true (default)
# create_migration_job = true

# After promotion: set to false to retire the DMS job, profiles, Network
# Attachment (restarts the instance) and firewall rule; Cloud SQL, the PSC
# endpoint and DNS stay (runbook section 10.2).
# migration_enabled = true

# Optional: deploy as a service account (also used by the gcloud local-exec steps)
# impersonate_service_account = "terraform-deployer@my-gcp-project-01.iam.gserviceaccount.com"
